DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=root
DATABASE_PASSWORD=admin
DATABASE_NAME=cidadon
DATABASE_SSL_MODE=disable

JWT_PROVIDER_PRIVATE_KEY=keys/jwt-private.pem
JWT_PROVIDER_PUBLIC_KEY=keys/jwt-public.pem
JWT_PROVIDER_ISSUER=cidadon
JWT_PROVIDER_AUDIENCE="['auth']"
JWT_PROVIDER_EXPIRATION=24h
REFRESH_TOKEN_PROVIDER_EXPIRATION=8760h

# Mailpit local (http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=convites@cidadon.local

# Media storage. Use local in development; S3 objects must be publicly readable.
MEDIA_DRIVER=local
MEDIA_LOCAL_DIR=../../.runtime/uploads
MEDIA_PUBLIC_BASE_URL=http://localhost:8080/media

# Required only when MEDIA_DRIVER=s3
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=
MEDIA_S3_ENDPOINT=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
